<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/startBackgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/epdbacckground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/levelPanel"
        android:layout_width="340dp"
        android:layout_height="430dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="24dp"
        android:paddingTop="22dp"
        android:paddingRight="24dp"
        android:paddingBottom="24dp"
        android:background="@drawable/level_panel_bg"
        app:layout_constraintBottom_toTopOf="@+id/startGameButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            android:id="@+id/levelTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_marginBottom="18dp" />

        <GridLayout
            android:id="@+id/levelGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:useDefaultMargins="true">

            <Space
                android:layout_width="64dp"
                android:layout_height="64dp" />

            <TextView
                android:id="@+id/levelButton10"
                style="@style/LevelSelectButton"
                android:text="10" />

            <Space
                android:layout_width="64dp"
                android:layout_height="64dp" />

            <TextView
                android:id="@+id/levelButton7"
                style="@style/LevelSelectButton"
                android:text="7" />

            <TextView
                android:id="@+id/levelButton8"
                style="@style/LevelSelectButton"
                android:text="8" />

            <TextView
                android:id="@+id/levelButton9"
                style="@style/LevelSelectButton"
                android:text="9" />

            <TextView
                android:id="@+id/levelButton4"
                style="@style/LevelSelectButton"
                android:text="4" />

            <TextView
                android:id="@+id/levelButton5"
                style="@style/LevelSelectButton"
                android:text="5" />

            <TextView
                android:id="@+id/levelButton6"
                style="@style/LevelSelectButton"
                android:text="6" />

            <TextView
                android:id="@+id/levelButton1"
                style="@style/LevelSelectButton"
                android:text="1" />

            <TextView
                android:id="@+id/levelButton2"
                style="@style/LevelSelectButton"
                android:text="2" />

            <TextView
                android:id="@+id/levelButton3"
                style="@style/LevelSelectButton"
                android:text="3" />

        </GridLayout>
    </LinearLayout>

    <Button
        android:id="@+id/startGameButton"
        android:layout_width="220dp"
        android:layout_height="64dp"
        android:layout_marginTop="28dp"
        android:onClick="onStartGameClicked"
        android:text="Start Game"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/levelPanel" />

</androidx.constraintlayout.widget.ConstraintLayout>